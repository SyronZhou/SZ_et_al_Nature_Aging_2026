!demo/*.csv
!demo/*.rds
*.sav
*.RData
*.rda

# Generated output
output/
figures/
results/

# R / RStudio
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj

# OS / editor cruft
.DS_Store
Thumbs.db
*~

